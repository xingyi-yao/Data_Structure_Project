{
  "_comment": "预训练配置：用莎士比亚戏剧全集学习基础语言规律",
  "data": {
    "data_path": "data/raw/pretrain.txt",
    "finetune_path": "data/raw/finetune.txt",
    "train_ratio": 0.9,
    "val_ratio": 0.05,
    "split_by_line": false
  },
  "model": {
    "n_embd": 512,
    "n_layer": 10,
    "n_head": 8,
    "context_length": 256,
    "dropout": 0.1
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 0.0003,
    "min_lr": 3e-05,
    "max_steps": 20000,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "weight_decay": 0.1,
    "seed": 42
  },
  "logging": {
    "log_interval": 10,
    "eval_interval": 500,
    "eval_iters": 20
  },
  "output": {
    "checkpoint_dir": "checkpoints",
    "output_dir": "outputs/training"
  }
}
